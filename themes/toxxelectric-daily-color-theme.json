  "tokenColors": [
    {
      "name": "Daily comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#b4a5c4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Daily purple accents",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "entity.name.function",
        "meta.function-call",
        "markup.heading",
        "markup.italic",
        "markup.bold",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#b99aff"
      }
    },
    {
      "name": "Daily yellow accents",
      "scope": [
        "variable",
        "constant.numeric",
        "constant.language",
        "support.function",
        "entity.name.tag",
        "markup.underline",
        "markup.strike"
      ],
      "settings": {
        "foreground": "#f6d365"
      }
    }
